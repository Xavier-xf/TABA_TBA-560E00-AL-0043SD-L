&i2c4 {
    pinctrl-names = "default","sleep";
    pinctrl-0 = <&i2c4_pins>;
    pinctrl-1 = <&i2c4_sleep_pins>;

    /*
    * SDA -- SCL
    */
    gpios = <&gpio XGPIO_031 GPIO_ACTIVE_HIGH
             &gpio XGPIO_030 GPIO_ACTIVE_HIGH
            >;


    /*clock-frequency = <100000>;
    sda-delay = <100>;
    */
    i2c-gpio,delay-us = <1>;
    status = "okay";
