                        XGPIO_037
                        XGPIO_036
                        XGPIO_035
                        XGPIO_034>;
        anyka,function = <XGPIO_027_FUNC_RGB_D23
                            XGPIO_026_FUNC_RGB_D22
                            XGPIO_025_FUNC_RGB_D21
