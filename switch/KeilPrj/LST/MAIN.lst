 242          /*************************************************
 243          函数名称:     void DelayXms(u16 xMs)
 244          功能描述:     延时程序，单位为ms
 245          输入参数:     u16 xMs -> *1ms  (1~65535)
 246          输出参数:     
 247          *************************************************/
 248          void DelayXms(u16 xMs)
 249          {
 250   1        while(xMs!=0)
 251   1        {
 252   2          CLRWDT();
 253   2          DelayXus(200);
 254   2          DelayXus(200);
 255   2          DelayXus(200);
 256   2          DelayXus(200);
 257   2          DelayXus(200);
 258   2          xMs--;
 259   2        }
 260   1      }
