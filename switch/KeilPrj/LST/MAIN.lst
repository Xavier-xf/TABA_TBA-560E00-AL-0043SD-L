 273          返回参数:     
 274          *************************************************************************************/
 275          void InitUart1(void)
 276          {
 277   1        UART1_SetMode8bitUARTVar();               // 8位 可变波特率
 278   1      
 279   1        UART1_EnS1BRG();                    //使能S1BRG波特率发生器
 280   1        UART1_SetBaudRateX1();                  //使能双倍波特率
 281   1        UART1_SetRxTxP12P13();                  //设置串口使用引脚：RX:P12 TX:P13
 282   1        UART1_EnReception();                  //使能串口接收功能
 283   1        UART1_SetS1BRGSelSYSCLK();                //设置S1BRG时钟源为系统时钟：1T
 284   1      
 285   1        UART1_SetS1BRGValue(S1BRG_BRGRL_9600_1X_12000000_1T); //设置S1BRG值及重载值
 286   1        
 287   1      }
