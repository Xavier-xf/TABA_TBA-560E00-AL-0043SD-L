 499   2          return -1;
 500   2        }
 501   1        //判断如果读到的数据最后一位不是“命令结束”，如果不是则返回不取
 502   1        if(temp_buf[length - 1] != CMD_END){
 503   2          return -1;
 504   2        }
 505   1        switch(length){
 506   2          case 0x03:
 507   2            *cmd   = temp_buf[0];
 508   2            check = (length + *cmd) & 0xFF;
 509   2            break;
 510   2          case 0x04:
 511   2            *cmd   = temp_buf[0];
 512   2            *data1 = temp_buf[1];
 513   2            check = (length + *cmd + *data1) & 0xFF;
 514   2            break;
 515   2          case 0x05:
 516   2            *cmd   = temp_buf[0];
 517   2            *data1 = temp_buf[1];
 518   2            *data2 = temp_buf[2];
 519   2            check = (length + *cmd + *data1 + *data2) & 0xFF;
 520   2            break;
 521   2          case 0x06:
 522   2            *cmd   = temp_buf[0];
 523   2            *data1 = temp_buf[1];
 524   2            *data2 = temp_buf[2];
 525   2            *data3 = temp_buf[3];
 526   2            check = (length + *cmd + *data1 + *data2 + *data3) & 0xFF;
 527   2            break;
 528   2          case 0x07:
 529   2            *cmd   = temp_buf[0];
 530   2            *data1 = temp_buf[1];
 531   2            *data2 = temp_buf[2];
 532   2            *data3 = temp_buf[3];
 533   2            *data4 = temp_buf[4];
 534   2            check = (length + *cmd + *data1 + *data2 + *data3 + *data4) & 0xFF;
 535   2            break;
 536   2        }
 537   1        //通过校验位判断数据是否发送正确，如果正确返回1，否则返回-1
 538   1        if(check != temp_buf[length - 2]){
 539   2          return -1;
 540   2        }else{
 541   2          return 1;
 542   2        }
 543   1      }
