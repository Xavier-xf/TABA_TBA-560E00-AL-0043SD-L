 403          ***********************************************************************/
 404          void send_can_cmd_encode(uint8_t cmd, uint8_t data1, uint8_t data2, uint8_t data3, uint8_t data4){
 405   1      
 406   1        uint8_t length = CMD_LENGTH_BASE;
 407   1        uint8_t check_code = 0;
 408   1        BOOL data1_null,data2_null,data3_null,data4_null;
 409   1        
 410   1        if(data1 != CMD_NULL){
 411   2          length++;
 412   2          data1_null = false;
 413   2        }else{
 414   2          data1 = 0x00;
 415   2          data1_null = true;
 416   2        }
 417   1        
 418   1        if(data2 != CMD_NULL || cmd == CMD_SEND_HOME_ID){
 419   2          length++;
 420   2          data2_null = false;
 421   2        }else{
 422   2          data2 = 0x00;
 423   2          data2_null = true;
 424   2        }
 425   1        
C51 COMPILER V9.54   KEVIN_FUNCTION                                                        01/15/2026 15:16:21 PAGE 8   

 426   1        if(data3 != CMD_NULL || cmd == CMD_SEND_HOME_ID){
 427   2          length++;
 428   2          data3_null = false;
 429   2        }else{
 430   2          data3 = 0x00;
 431   2          data3_null = true;
 432   2        }
 433   1        
 434   1        if(data4 != CMD_NULL){
 435   2          length++;
 436   2          data4_null = false;
 437   2        }else{
 438   2          data4 = 0x00;
 439   2          data4_null = true;
 440   2        }
 441   1      
 442   1        check_code = (length + cmd + data1 + data2 + data3 + data4) & 0xFF;
 443   1        
 444   1        Uart1SendByte(CMD_START);
 445   1        Uart1SendByte(length);
 446   1        Uart1SendByte(cmd);
 447   1        if(data1_null == false){
 448   2          Uart1SendByte(data1);
 449   2        }
 450   1        if(data2_null == false){
 451   2          Uart1SendByte(data2);
 452   2        }
 453   1        if(data3_null == false){
 454   2          Uart1SendByte(data3);
 455   2        }
 456   1        if(data4_null == false){
 457   2          Uart1SendByte(data4);
 458   2        }
 459   1        Uart1SendByte(check_code);
 460   1        Uart1SendByte(CMD_END);
 461   1        Uart1SendByte(length + 0x02); 
 462   1      }
