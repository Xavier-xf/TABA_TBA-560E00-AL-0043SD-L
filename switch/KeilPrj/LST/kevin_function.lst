 321          /***********************************************************************************
 322          函数名称:   void INT_UART1(void)
 323          功能描述:UART1 中断服务程序
 324               
 325          输入参数:   
 326          返回参数:     
 327          *************************************************************************************/
 328          void INT_UART1(void) interrupt INT_VECTOR_UART1
 329          {
 330   1        _push_(SFRPI);       //保护SFRPI寄存器值
 331   1        SFR_SetPage(1);      /*设置1页寄存器*/  //S1CON仅1页操作
 332   1        
 333   1        if(TI1)         //发送中断内容
 334   1        {
 335   2          TI1 = 0;     
 336   2          if(UartClass.tx_in_index == UartClass.tx_out_index){
 337   3            UartClass.tx_falg = FALSE;
 338   3            UartClass.tx_in_index = 0;
 339   3            UartClass.tx_out_index = 0;
 340   3          }else{
 341   3            S1BUF = get_uart_tx_buf();
 342   3            UartClass.tx_falg = TRUE;
 343   3          }
 344   2        }
 345   1        if(RI1)         //接收中断内容
 346   1        {
 347   2          RI1 = 0;        //清除中断标志
 348   2          post_uart_rx_buf(S1BUF);
 349   2        }
 350   1        _pop_(SFRPI);      //恢复SFRPI寄存器值
 351   1      }
