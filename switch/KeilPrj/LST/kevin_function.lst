 211          /***********************************************************************
 212          @Function:    保存用户数据
 213          @Input:       (USER_DATA_ADDR)  addr：将要保存的id地址    
 214                  (uint8_t) *home_id：要保存的数据指针
 215          @Output:      (void)
 216          @Description: 将要保寸的数据保存到IAP区,因为flash数据任何一位只能写0，
 217                        如果需要写1，falsh需要擦除，但是ISP/IAP擦除只支持页擦除，
 218                        一页有512个字节，所以擦除后要将其他数据重新写入IAP。
 219          @Author:      kevin
 220          @Date:        2021-09-06
 221          ***********************************************************************/
 222          void save_user_data(USER_DATA_ADDR addr, uint8_t *home_id){
 223   1        uint8_t tmp;
 224   1      
 225   1        tmp = PageP_Read(IAPLB_P);
 226   1        //*1.   Set IAP Low Boundary Address
 227   1        PageP_Write(IAPLB_P, (addr >> 8));        //set IAPLB address at 0x7200
 228   1        //*2.   Set IAP Control Process
 229   1        IAP_Erase((addr >> 8), (addr & 0xFF));
 230   1      
 231   1        switch(addr){
 232   2          case HOME1_ID_ADDR:
 233   2            UserData.home1_id[0] = home_id[0];
 234   2            UserData.home1_id[1] = home_id[1];
 235   2            UserData.home1_id[2] = home_id[2];
 236   2            UserData.home1_id[3] = home_id[3];
 237   2            break;
 238   2          case HOME2_ID_ADDR:
 239   2            UserData.home2_id[0] = home_id[0];
C51 COMPILER V9.54   KEVIN_FUNCTION                                                        01/15/2026 15:16:21 PAGE 5   

 240   2            UserData.home2_id[1] = home_id[1];
 241   2            UserData.home2_id[2] = home_id[2];
 242   2            UserData.home2_id[3] = home_id[3];
 243   2            break;
 244   2          case HOME3_ID_ADDR:     
 245   2            UserData.home3_id[0] = home_id[0];
 246   2            UserData.home3_id[1] = home_id[1];
 247   2            UserData.home3_id[2] = home_id[2];
 248   2            UserData.home3_id[3] = home_id[3];
 249   2            break;
 250   2          case HOME4_ID_ADDR:
 251   2            UserData.home4_id[0] = home_id[0];
 252   2            UserData.home4_id[1] = home_id[1];
 253   2            UserData.home4_id[2] = home_id[2];
 254   2            UserData.home4_id[3] = home_id[3];
 255   2            break;
 256   2          case HOME_ID_DEFAULT_ADDR:
 257   2            UserData.home_id_default[0] = home_id[0];
 258   2            UserData.home_id_default[1] = home_id[1];
 259   2            UserData.home_id_default[2] = home_id[2];
 260   2            UserData.home_id_default[3] = home_id[3];
 261   2            break;
 262   2        }
 263   1      
 264   1        save_home_id();
 265   1          
 266   1        PageP_Write(IAPLB_P, tmp);
 267   1      }
