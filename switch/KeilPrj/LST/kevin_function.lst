  12          // xiang:读取拨码开关状态并反转位序
  13          void read_dip_switch(void) {
  14   1          uint8_t raw_value = 0;
  15   1          // xiang:读取8位拨码开关状态 
  16   1        raw_value |= (DIP_SW1 ? 0 : 1) << 7;
  17   1        raw_value |= (DIP_SW2 ? 0 : 1) << 6;
  18   1        raw_value |= (DIP_SW3 ? 0 : 1) << 5;
  19   1        raw_value |= (DIP_SW4 ? 0 : 1) << 4;
  20   1        raw_value |= (DIP_SW5 ? 0 : 1) << 3;
  21   1        raw_value |= (DIP_SW6 ? 0 : 1) << 2;
  22   1        raw_value |= (DIP_SW7 ? 0 : 1) << 1;
  23   1        raw_value |= (DIP_SW8 ? 0 : 1) << 0;
  24   1          
  25   1        // xiang:位反转 (MSB->LSB)
  26   1        raw_value &= 0xFE;
  27   1          dip_switch_value = reverse_bits(raw_value);  // 直接反转高8位
  28   1      }
  29          
  30          // xiang位反转函数 (0bABCDEFGH -> 0bHGFEDCBA)
  31          u8 reverse_bits(u8 value) {
  32   1          u8 result = 0;
  33   1        u8 i=0;
  34   1          for( i = 0; i < 8; i++) {
  35   2              result <<= 1;
  36   2              result |= (value & 0x01);
  37   2              value >>= 1;
  38   2          }
  39   1          return result;
  40   1      }
