 483   2          if(temp_buf[0] != CMD_START){
 484   3            return -1;
 485   3          }
 486   2        }else{
 487   2          return -1;
C51 COMPILER V9.54   KEVIN_FUNCTION                                                        01/15/2026 15:16:21 PAGE 9   

 488   2        }
 489   1        //此处延时时间不能更改，否则会接收数据异常
 490   1        DelayXms(10);
 491   1        //读取数据长度
 492   1        if(get_uart_rx_buf(1, &temp_buf) == 0){
 493   2          return -1;
 494   2        }
 495   1        length = temp_buf[0];
 496   1        //此处延时时间不能更改，否则会接收数据异常
 497   1        DelayXms(10);
