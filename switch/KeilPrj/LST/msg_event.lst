 406          @Output:      (void)
 407          @Description: 防抖定时器超时后的处理，确认开锁事件
 408          @Author:      kevin
 409          @Date:        2023-11-15
 410          ************************************************************************/
 411          static void unlock_debounce_timeout(void)
 412          {
 413   1          Event event = {0};
 414   1          
 415   1          // 防抖定时器超时，确认开锁事件
 416   1          if(debounce_flag) {
 417   2              // 检查当前GPIO状态是否仍为低电平
 418   2              if((UNLOCK_GPIO == 0) && (pre_status == HIGH_LEVEL) && 
 419   2                 (Intercom.unlock_status == UNLOCK_IDLE)) {
 420   3                  // 确认开锁开始
 421   3                  pre_status = LOW_LEVEL;
C51 COMPILER V9.54   MSG_EVENT                                                             01/17/2026 11:48:10 PAGE 8   

 422   3                  event.type = EVENT_TYPE_UNLOCK_START;
 423   3                  msg_event_post(&event);
 424   3              }
 425   2              
 426   2              // 重置防抖标志
 427   2              debounce_flag = 0;
 428   2          }
 429   1          
 430   1          // 清除定时器
 431   1          kill_timer(TIMER0);
 432   1      }
