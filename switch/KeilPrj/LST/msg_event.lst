 597   2              UserData.home1_id[0] = 0;    UserData.home1_id[1] = 0xFF;    UserData.home1_id[2] = 0;    UserData
             -.home1_id[3] = 0xFF;
 598   2              UserData.home2_id[0] = 0;    UserData.home2_id[1] = 0xFF;    UserData.home2_id[2] = 0;    UserData
             -.home2_id[3] = 0xFF;
 599   2              UserData.home3_id[0] = 0;    UserData.home3_id[1] = 0xFF;    UserData.home3_id[2] = 0;    UserData
             -.home3_id[3] = 0xFF;
 600   2              UserData.home4_id[0] = 0;    UserData.home4_id[1] = 0xFF;    UserData.home4_id[2] = 0;    UserData
             -.home4_id[3] = 0xFF;
 601   2      
 602   2              // 将默认值持久化保存到闪存(IAP)，保证重启后依然生效
 603   2              save_user_data(HOME1_ID_ADDR, UserData.home1_id);
C51 COMPILER V9.54   MSG_EVENT                                                             01/17/2026 11:48:10 PAGE 11  

 604   2              save_user_data(HOME2_ID_ADDR, UserData.home2_id);
 605   2              save_user_data(HOME3_ID_ADDR, UserData.home3_id);
 606   2              save_user_data(HOME4_ID_ADDR, UserData.home4_id);
 607   2      
 608   2              //  更新历史值，避免重复触发恢复逻辑
 609   2              prev_base_address = new_base_addr;
 610   2          }
 611   1      
 612   1          //  更新当前分支器地址
 613   1          base_address = new_base_addr;
 614   1      }
