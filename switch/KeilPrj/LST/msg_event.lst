  26          static char msg_event_get(Event* ev)
  27          {
  28   1          int index;
  29   1          if(EventQueueCont == 0) {
  30   2              ev->type = EVENT_TYPE_NONE;
  31   2              ev->arg1 = 0;
  32   2              ev->arg2 = 0;
  33   2              return -1;
  34   2          }
  35   1          index = EventQueueIndex;
  36   1          EventQueueIndex = (EventQueueIndex + 1) % EVENT_QUEUE_MAX;
  37   1          EventQueueCont--;
  38   1          ev->type = EventQueue[index].type;
  39   1          ev->arg1 = EventQueue[index].arg1;
  40   1          ev->arg2 = EventQueue[index].arg2;
  41   1          return 1;
  42   1      }
