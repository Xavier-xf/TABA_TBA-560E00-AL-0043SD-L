 117   2              if(is_home_id_set(home_id)) {
 118   3                  if(dial_number == room_number) {
 119   4                      // 匹配成功
 120   4                      send_can_cmd_encode(CMD_ACK, 0x00, CMD_NULL, CMD_NULL, CMD_NULL);
 121   4                      event.type = EVENT_TYPE_CALL;
 122   4                      event.arg1 = i + 1;
 123   4                      msg_event_post(&event);
 124   4                      return;
 125   4                  }
 126   3              }
 127   2          // 如果未设置软件房号，检查硬件房号
 128   2          else {
 129   3                  // 硬件计算逻辑
 130   3                  u16 raw_input = data1 * 1000 + data2 * 100 + data3 * 10 + data4;
 131   3                  u16 converted_num = 0;
 132   3                  
 133   3                  if (DIP_SW8) {
 134   4                      converted_num = raw_input;
 135   4                  } else {
 136   4                      uint8_t floor = data1 * 10 + data2;
 137   4                      uint8_t room = data3 * 10 + data4;
 138   4                      converted_num = (floor - 1) * 10 + room;
 139   4                  }
 140   3                  
 141   3                  calculated_base = (converted_num - 1) / 4;
 142   3                  home_index = (converted_num - 1) % 4 + 1;
 143   3                  
 144   3                  if (calculated_base == base_address && home_index == (i + 1)) {
 145   4                      // 匹配成功
 146   4                      send_can_cmd_encode(CMD_ACK, 0x00, CMD_NULL, CMD_NULL, CMD_NULL);
 147   4                      event.type = EVENT_TYPE_CALL;
 148   4                      event.arg1 = i + 1;
 149   4                      msg_event_post(&event);
 150   4                      return;
 151   4                  }
 152   3              }
 153   2          }
 154   1      }
