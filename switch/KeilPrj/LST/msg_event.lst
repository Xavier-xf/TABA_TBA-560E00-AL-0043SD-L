  59   1          if (EventQueueCont >= EVENT_QUEUE_MAX) {
  60   2              return -1;
  61   2          }
  62   1          index = (EventQueueIndex + EventQueueCont) % EVENT_QUEUE_MAX;
  63   1          EventQueue[index].type = ev->type;
  64   1          EventQueue[index].arg1 = ev->arg1;
  65   1          EventQueue[index].arg2 = ev->arg2;
  66   1          EventQueueCont++;
  67   1          return 0;
  68   1      }
