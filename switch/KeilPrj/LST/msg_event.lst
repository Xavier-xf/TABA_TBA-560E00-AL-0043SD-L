C51 COMPILER V9.54   MSG_EVENT                                                             01/17/2026 11:48:10 PAGE 7   

 360                        只对低电平（开锁开始）进行防抖，高电平（开锁结束）立即响应
 361          @Author:      kevin
 362          @Date:        2021-08-24
 363          @Modified:    2025-12-7 增加防抖功能
 364          ************************************************************************/
 365          static void sys_unlock_check(void)
 366          {
 367   1          Event event = {0};
 368   1          
 369   1          // 读取当前GPIO状态
 370   1          LEVEL current_gpio = (UNLOCK_GPIO == 0) ? LOW_LEVEL : HIGH_LEVEL;
 371   1          
 372   1          // 处理高电平 -> 开锁结束（立即响应，不需要防抖）
 373   1          if((current_gpio == HIGH_LEVEL) && (Intercom.unlock_status == UNLOCK_BUSY)) {
 374   2              // 取消可能存在的防抖定时器
 375   2              if(debounce_flag) {
 376   3                  kill_timer(TIMER0);
 377   3                  debounce_flag = 0;
 378   3              }
 379   2              
 380   2              pre_status = HIGH_LEVEL;
 381   2              event.type = EVENT_TYPE_UNLOCK_END;
 382   2              msg_event_post(&event);
 383   2              return;
 384   2          }
 385   1          
 386   1          // 处理低电平 -> 开锁开始（需要防抖）
 387   1          if((current_gpio == LOW_LEVEL) && (pre_status == HIGH_LEVEL) && 
 388   1             (Intercom.unlock_status == UNLOCK_IDLE)) {
 389   2              if(!debounce_flag) {
 390   3                  // 第一次检测到低电平，启动防抖定时器
 391   3                  debounce_flag = 1;
 392   3                  set_timer(TIMER0, TID_100mSEC, unlock_debounce_timeout);
 393   3              }
 394   2          } else if(current_gpio == HIGH_LEVEL) {
 395   2              // 当前是高电平，取消防抖
 396   2              if(debounce_flag) {
 397   3                  kill_timer(TIMER0);
 398   3                  debounce_flag = 0;
 399   3              }
 400   2          }
 401   1      }
 402          
 403          /***********************************************************************
 404          @Function:    开锁防抖超时处理
